#include <Arduino.h>
#include <EEPROM.h>

constexpr uint8_t SENSOR_PIN = 2;
constexpr uint8_t RESET_PIN = 3;
constexpr uint8_t LED_PIN = 9;

constexpr uint16_t ENTPRELLZEIT_MS = 40;
constexpr uint16_t RESETZEIT_MS = 1500;
constexpr uint16_t BLINKZEIT_MS = 120;

constexpr int EEPROM_ADRESSE = 0;
constexpr uint8_t EEPROM_CODE = 0x6D;

struct Speicherblock {
  uint8_t code;
  uint8_t status;
  uint8_t pruefsumme;
};

class Eingang {
public:
  Eingang(uint8_t pin, uint16_t entprellzeit)
      : pin_(pin),
        entprellzeit_(entprellzeit),
        roh_(HIGH),
        stabil_(HIGH),
        vorher_(HIGH),
        wechselzeit_(0) {}

  void beginnen() {
    pinMode(pin_, INPUT_PULLUP);
    roh_ = digitalRead(pin_);
    stabil_ = roh_;
    vorher_ = stabil_;
    wechselzeit_ = millis();
  }

  void aktualisieren() {
    vorher_ = stabil_;

    bool aktuell = digitalRead(pin_);
    unsigned long jetzt = millis();

    if (aktuell != roh_) {
      roh_ = aktuell;
      wechselzeit_ = jetzt;
    }

    if (roh_ != stabil_ && jetzt - wechselzeit_ >= entprellzeit_) {
      stabil_ = roh_;
    }
  }

  bool aktiv() const {
    return stabil_ == LOW;
  }

  bool aktiviert() const {
    return vorher_ == HIGH && stabil_ == LOW;
  }

  bool deaktiviert() const {
    return vorher_ == LOW && stabil_ == HIGH;
  }

private:
  uint8_t pin_;
  uint16_t entprellzeit_;
  bool roh_;
  bool stabil_;
  bool vorher_;
  unsigned long wechselzeit_;
};

Eingang sensor(SENSOR_PIN, ENTPRELLZEIT_MS);
Eingang resetTaste(RESET_PIN, ENTPRELLZEIT_MS);

bool postVorhanden = false;
bool resetLaeuft = false;
bool resetFertig = false;
bool blinkStatus = false;

unsigned long resetStartzeit = 0;
unsigned long letzteBlinkzeit = 0;

uint8_t pruefsumme(uint8_t status) {
  return EEPROM_CODE ^ status ^ 0xA5;
}

void ledSetzen(bool zustand) {
  digitalWrite(LED_PIN, zustand ? HIGH : LOW);
}

void statusAnzeigen() {
  ledSetzen(postVorhanden);
}

void statusSpeichern() {
  Speicherblock daten{
    EEPROM_CODE,
    static_cast<uint8_t>(postVorhanden ? 1 : 0),
    pruefsumme(static_cast<uint8_t>(postVorhanden ? 1 : 0))
  };

  const uint8_t* bytes = reinterpret_cast<const uint8_t*>(&daten);

  for (size_t i = 0; i < sizeof(Speicherblock); ++i) {
    EEPROM.update(EEPROM_ADRESSE + i, bytes[i]);
  }
}

void statusLaden() {
  Speicherblock daten;
  EEPROM.get(EEPROM_ADRESSE, daten);

  bool gueltig =
    daten.code == EEPROM_CODE &&
    daten.status <= 1 &&
    daten.pruefsumme == pruefsumme(daten.status);

  if (gueltig) {
    postVorhanden = daten.status == 1;
  } else {
    postVorhanden = false;
    statusSpeichern();
  }
}

void postRegistrieren() {
  if (postVorhanden) {
    return;
  }

  postVorhanden = true;
  statusSpeichern();
  statusAnzeigen();
}

void postZuruecksetzen() {
  if (!postVorhanden) {
    return;
  }

  postVorhanden = false;
  statusSpeichern();
  statusAnzeigen();
}

void sensorVerarbeiten() {
  sensor.aktualisieren();

  if (sensor.aktiviert()) {
    postRegistrieren();
  }
}

void resetBlinken(unsigned long jetzt) {
  if (jetzt - letzteBlinkzeit < BLINKZEIT_MS) {
    return;
  }

  letzteBlinkzeit = jetzt;
  blinkStatus = !blinkStatus;
  ledSetzen(blinkStatus);
}

void resetVerarbeiten() {
  resetTaste.aktualisieren();

  unsigned long jetzt = millis();

  if (resetTaste.aktiviert()) {
    resetLaeuft = true;
    resetFertig = false;
    resetStartzeit = jetzt;
    letzteBlinkzeit = jetzt;
    blinkStatus = false;
  }

  if (resetLaeuft && resetTaste.aktiv() && !resetFertig) {
    resetBlinken(jetzt);

    if (jetzt - resetStartzeit >= RESETZEIT_MS) {
      postZuruecksetzen();
      resetFertig = true;
      resetLaeuft = false;
    }
  }

  if (resetTaste.deaktiviert()) {
    resetLaeuft = false;
    resetFertig = false;
    statusAnzeigen();
  }
}

void setup() {
  pinMode(LED_PIN, OUTPUT);

  sensor.beginnen();
  resetTaste.beginnen();

  statusLaden();
  statusAnzeigen();
}

void loop() {
  sensorVerarbeiten();
  resetVerarbeiten();
}
