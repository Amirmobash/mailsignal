#include <EEPROM.h>

constexpr uint8_t SENSOR_PIN = 2;
constexpr uint8_t RESET_PIN = 3;
constexpr uint8_t LED_PIN = 9;

constexpr uint16_t ENTPRELLZEIT_MS = 40;
constexpr uint16_t RESETZEIT_MS = 1200;

constexpr int EEPROM_ADRESSE = 0;
constexpr uint8_t STATUS_AUS = 0x3C;
constexpr uint8_t STATUS_AN = 0xC3;

class Eingang {
public:
  Eingang(uint8_t pin, uint16_t entprellzeit)
      : pin(pin),
        entprellzeit(entprellzeit),
        rohzustand(HIGH),
        zustand(HIGH),
        vorherigerZustand(HIGH),
        wechselzeit(0) {}

  void starten() {
    pinMode(pin, INPUT_PULLUP);
    rohzustand = digitalRead(pin);
    zustand = rohzustand;
    vorherigerZustand = zustand;
    wechselzeit = millis();
  }

  void aktualisieren() {
    vorherigerZustand = zustand;

    bool neuerRohzustand = digitalRead(pin);
    unsigned long jetzt = millis();

    if (neuerRohzustand != rohzustand) {
      rohzustand = neuerRohzustand;
      wechselzeit = jetzt;
    }

    if (
      zustand != rohzustand &&
      jetzt - wechselzeit >= entprellzeit
    ) {
      zustand = rohzustand;
    }
  }

  bool aktiv() const {
    return zustand == LOW;
  }

  bool aktiviert() const {
    return vorherigerZustand == HIGH && zustand == LOW;
  }

  bool deaktiviert() const {
    return vorherigerZustand == LOW && zustand == HIGH;
  }

private:
  uint8_t pin;
  uint16_t entprellzeit;
  bool rohzustand;
  bool zustand;
  bool vorherigerZustand;
  unsigned long wechselzeit;
};

Eingang klappensensor(SENSOR_PIN, ENTPRELLZEIT_MS);
Eingang resetTaste(RESET_PIN, ENTPRELLZEIT_MS);

bool postVorhanden = false;
bool resetGestartet = false;
bool resetAusgefuehrt = false;

unsigned long resetStartzeit = 0;

void ausgangAktualisieren() {
  digitalWrite(LED_PIN, postVorhanden ? HIGH : LOW);
}

void statusSpeichern() {
  uint8_t neuerWert = postVorhanden ? STATUS_AN : STATUS_AUS;

  if (EEPROM.read(EEPROM_ADRESSE) != neuerWert) {
    EEPROM.update(EEPROM_ADRESSE, neuerWert);
  }
}

void statusLaden() {
  uint8_t gespeicherterWert = EEPROM.read(EEPROM_ADRESSE);

  if (gespeicherterWert == STATUS_AN) {
    postVorhanden = true;
  } else {
    postVorhanden = false;

    if (gespeicherterWert != STATUS_AUS) {
      statusSpeichern();
    }
  }
}

void postMelden() {
  if (postVorhanden) {
    return;
  }

  postVorhanden = true;
  statusSpeichern();
  ausgangAktualisieren();
}

void postZuruecksetzen() {
  if (!postVorhanden) {
    return;
  }

  postVorhanden = false;
  statusSpeichern();
  ausgangAktualisieren();
}

void sensorVerarbeiten() {
  klappensensor.aktualisieren();

  if (klappensensor.aktiviert()) {
    postMelden();
  }
}

void resetVerarbeiten() {
  resetTaste.aktualisieren();

  unsigned long jetzt = millis();

  if (resetTaste.aktiviert()) {
    resetGestartet = true;
    resetAusgefuehrt = false;
    resetStartzeit = jetzt;
  }

  if (
    resetTaste.aktiv() &&
    resetGestartet &&
    !resetAusgefuehrt &&
    jetzt - resetStartzeit >= RESETZEIT_MS
  ) {
    postZuruecksetzen();
    resetAusgefuehrt = true;
  }

  if (resetTaste.deaktiviert()) {
    resetGestartet = false;
    resetAusgefuehrt = false;
  }
}

void setup() {
  pinMode(LED_PIN, OUTPUT);

  klappensensor.starten();
  resetTaste.starten();

  statusLaden();
  ausgangAktualisieren();
}

void loop() {
  sensorVerarbeiten();
  resetVerarbeiten();
}
