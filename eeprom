#include <EEPROM.h>

constexpr uint8_t SENSOR_PIN = 2;
constexpr uint8_t TASTER_PIN = 3;
constexpr uint8_t LED_PIN = 9;

constexpr uint16_t ENTPRELLZEIT_MS = 50;
constexpr uint16_t RESETZEIT_MS = 1200;

constexpr uint8_t EEPROM_ADRESSE = 0;
constexpr uint8_t EEPROM_KENNUNG = 0xB6;

struct Eingang {
  uint8_t pin;
  bool roh;
  bool stabil;
  bool vorher;
  unsigned long wechselzeit;
};

struct Speicher {
  uint8_t kennung;
  uint8_t status;
  uint8_t pruefsumme;
};

Eingang briefSensor;
Eingang resetTaster;

bool postVorhanden = false;
bool resetGestartet = false;
bool resetAusgefuehrt = false;

unsigned long resetStartzeit = 0;

uint8_t pruefsummeBerechnen(uint8_t status) {
  return EEPROM_KENNUNG ^ status ^ 0x6D;
}

void eingangInitialisieren(Eingang& eingang, uint8_t pin) {
  eingang.pin = pin;

  pinMode(eingang.pin, INPUT_PULLUP);

  bool zustand = digitalRead(eingang.pin);

  eingang.roh = zustand;
  eingang.stabil = zustand;
  eingang.vorher = zustand;
  eingang.wechselzeit = millis();
}

void eingangAktualisieren(Eingang& eingang) {
  bool aktuellerZustand = digitalRead(eingang.pin);
  unsigned long jetzt = millis();

  eingang.vorher = eingang.stabil;

  if (aktuellerZustand != eingang.roh) {
    eingang.roh = aktuellerZustand;
    eingang.wechselzeit = jetzt;
  }

  if (
    eingang.roh != eingang.stabil &&
    jetzt - eingang.wechselzeit >= ENTPRELLZEIT_MS
  ) {
    eingang.stabil = eingang.roh;
  }
}

bool wurdeAktiviert(const Eingang& eingang) {
  return eingang.vorher == HIGH && eingang.stabil == LOW;
}

bool wurdeFreigegeben(const Eingang& eingang) {
  return eingang.vorher == LOW && eingang.stabil == HIGH;
}

bool istAktiv(const Eingang& eingang) {
  return eingang.stabil == LOW;
}

void anzeigeAktualisieren() {
  digitalWrite(LED_PIN, postVorhanden ? HIGH : LOW);
}

void statusSpeichern() {
  Speicher neueDaten = {
    EEPROM_KENNUNG,
    postVorhanden ? static_cast<uint8_t>(1) : static_cast<uint8_t>(0),
    0
  };

  neueDaten.pruefsumme = pruefsummeBerechnen(neueDaten.status);

  Speicher alteDaten;
  EEPROM.get(EEPROM_ADRESSE, alteDaten);

  bool unveraendert =
    alteDaten.kennung == neueDaten.kennung &&
    alteDaten.status == neueDaten.status &&
    alteDaten.pruefsumme == neueDaten.pruefsumme;

  if (!unveraendert) {
    EEPROM.put(EEPROM_ADRESSE, neueDaten);
  }
}

void statusLaden() {
  Speicher daten;
  EEPROM.get(EEPROM_ADRESSE, daten);

  bool gueltig =
    daten.kennung == EEPROM_KENNUNG &&
    daten.status <= 1 &&
    daten.pruefsumme == pruefsummeBerechnen(daten.status);

  if (gueltig) {
    postVorhanden = daten.status == 1;
  } else {
    postVorhanden = false;
    statusSpeichern();
  }
}

void postMelden() {
  if (postVorhanden) {
    return;
  }

  postVorhanden = true;
  anzeigeAktualisieren();
  statusSpeichern();
}

void postZuruecksetzen() {
  if (!postVorhanden) {
    return;
  }

  postVorhanden = false;
  anzeigeAktualisieren();
  statusSpeichern();
}

void sensorBearbeiten() {
  eingangAktualisieren(briefSensor);

  if (wurdeAktiviert(briefSensor)) {
    postMelden();
  }
}

void tasterBearbeiten() {
  eingangAktualisieren(resetTaster);

  unsigned long jetzt = millis();

  if (wurdeAktiviert(resetTaster)) {
    resetGestartet = true;
    resetAusgefuehrt = false;
    resetStartzeit = jetzt;
  }

  if (
    resetGestartet &&
    !resetAusgefuehrt &&
    istAktiv(resetTaster) &&
    jetzt - resetStartzeit >= RESETZEIT_MS
  ) {
    postZuruecksetzen();
    resetAusgefuehrt = true;
  }

  if (wurdeFreigegeben(resetTaster)) {
    resetGestartet = false;
    resetAusgefuehrt = false;
  }
}

void setup() {
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  eingangInitialisieren(briefSensor, SENSOR_PIN);
  eingangInitialisieren(resetTaster, TASTER_PIN);

  statusLaden();
  anzeigeAktualisieren();
}

void loop() {
  sensorBearbeiten();
  tasterBearbeiten();
}
