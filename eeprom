#include <EEPROM.h>

constexpr uint8_t SENSOR_PIN = 2;
constexpr uint8_t RESET_PIN = 3;
constexpr uint8_t LED_PIN = 9;

constexpr uint8_t EEPROM_ADRESSE = 0;
constexpr uint8_t STATUS_AKTIV = 0x5A;
constexpr uint8_t STATUS_INAKTIV = 0xA5;

constexpr unsigned long SENSOR_ENTPRELLZEIT = 40;
constexpr unsigned long RESET_ENTPRELLZEIT = 40;
constexpr unsigned long RESET_HALTEZEIT = 1000;

class Eingang {
public:
  Eingang(uint8_t pin, unsigned long entprellzeit)
      : pin(pin),
        entprellzeit(entprellzeit),
        rohzustand(HIGH),
        stabilerZustand(HIGH),
        letzterStabilerZustand(HIGH),
        wechselzeit(0) {}

  void beginnen() {
    pinMode(pin, INPUT_PULLUP);
    rohzustand = digitalRead(pin);
    stabilerZustand = rohzustand;
    letzterStabilerZustand = stabilerZustand;
    wechselzeit = millis();
  }

  void aktualisieren() {
    letzterStabilerZustand = stabilerZustand;

    bool neuerRohzustand = digitalRead(pin);
    unsigned long jetzt = millis();

    if (neuerRohzustand != rohzustand) {
      rohzustand = neuerRohzustand;
      wechselzeit = jetzt;
    }

    if (
      rohzustand != stabilerZustand &&
      jetzt - wechselzeit >= entprellzeit
    ) {
      stabilerZustand = rohzustand;
    }
  }

  bool aktiv() const {
    return stabilerZustand == LOW;
  }

  bool wurdeAktiviert() const {
    return letzterStabilerZustand == HIGH &&
           stabilerZustand == LOW;
  }

  bool wurdeFreigegeben() const {
    return letzterStabilerZustand == LOW &&
           stabilerZustand == HIGH;
  }

private:
  uint8_t pin;
  unsigned long entprellzeit;
  bool rohzustand;
  bool stabilerZustand;
  bool letzterStabilerZustand;
  unsigned long wechselzeit;
};

Eingang sensor(SENSOR_PIN, SENSOR_ENTPRELLZEIT);
Eingang resetTaste(RESET_PIN, RESET_ENTPRELLZEIT);

bool postVorhanden = false;
bool resetGestartet = false;
bool resetAusgefuehrt = false;

unsigned long resetStartzeit = 0;

void ausgangAktualisieren() {
  digitalWrite(LED_PIN, postVorhanden ? HIGH : LOW);
}

void statusSpeichern() {
  uint8_t wert = postVorhanden ? STATUS_AKTIV : STATUS_INAKTIV;

  if (EEPROM.read(EEPROM_ADRESSE) != wert) {
    EEPROM.update(EEPROM_ADRESSE, wert);
  }
}

void statusLaden() {
  uint8_t wert = EEPROM.read(EEPROM_ADRESSE);

  if (wert == STATUS_AKTIV) {
    postVorhanden = true;
  } else {
    postVorhanden = false;

    if (wert != STATUS_INAKTIV) {
      statusSpeichern();
    }
  }
}

void postAktivieren() {
  if (postVorhanden) {
    return;
  }

  postVorhanden = true;
  statusSpeichern();
  ausgangAktualisieren();
}

void postZuruecksetzen() {
  if (!postVorhanden) {
    return;
  }

  postVorhanden = false;
  statusSpeichern();
  ausgangAktualisieren();
}

void sensorVerarbeiten() {
  sensor.aktualisieren();

  if (sensor.wurdeAktiviert()) {
    postAktivieren();
  }
}

void resetVerarbeiten() {
  resetTaste.aktualisieren();
  unsigned long jetzt = millis();

  if (resetTaste.wurdeAktiviert()) {
    resetGestartet = true;
    resetAusgefuehrt = false;
    resetStartzeit = jetzt;
  }

  if (
    resetGestartet &&
    !resetAusgefuehrt &&
    resetTaste.aktiv() &&
    jetzt - resetStartzeit >= RESET_HALTEZEIT
  ) {
    postZuruecksetzen();
    resetAusgefuehrt = true;
  }

  if (resetTaste.wurdeFreigegeben()) {
    resetGestartet = false;
    resetAusgefuehrt = false;
  }
}

void setup() {
  pinMode(LED_PIN, OUTPUT);

  sensor.beginnen();
  resetTaste.beginnen();

  statusLaden();
  ausgangAktualisieren();
}

void loop() {
  sensorVerarbeiten();
  resetVerarbeiten();
}
