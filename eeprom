#include <EEPROM.h>

constexpr uint8_t SENSOR_PIN = 2;
constexpr uint8_t RESET_PIN = 3;
constexpr uint8_t LED_PIN = 9;

constexpr uint16_t ENTPRELLZEIT_MS = 40;
constexpr uint16_t RESETZEIT_MS = 1200;

constexpr uint16_t EEPROM_ADRESSE = 0;
constexpr uint8_t EEPROM_KENNUNG = 0x6D;

struct Speicher {
  uint8_t kennung;
  uint8_t status;
  uint8_t pruefsumme;
};

class Eingang {
public:
  Eingang(uint8_t pin, uint16_t entprellzeit)
      : pin(pin),
        entprellzeit(entprellzeit),
        rohzustand(HIGH),
        zustand(HIGH),
        letzterZustand(HIGH),
        wechselzeit(0) {}

  void starten() {
    pinMode(pin, INPUT_PULLUP);

    rohzustand = digitalRead(pin);
    zustand = rohzustand;
    letzterZustand = zustand;
    wechselzeit = millis();
  }

  void aktualisieren() {
    letzterZustand = zustand;

    bool neuerRohzustand = digitalRead(pin);
    unsigned long jetzt = millis();

    if (neuerRohzustand != rohzustand) {
      rohzustand = neuerRohzustand;
      wechselzeit = jetzt;
    }

    if (
      zustand != rohzustand &&
      jetzt - wechselzeit >= entprellzeit
    ) {
      zustand = rohzustand;
    }
  }

  bool aktiv() const {
    return zustand == LOW;
  }

  bool aktiviert() const {
    return letzterZustand == HIGH && zustand == LOW;
  }

  bool deaktiviert() const {
    return letzterZustand == LOW && zustand == HIGH;
  }

private:
  uint8_t pin;
  uint16_t entprellzeit;
  bool rohzustand;
  bool zustand;
  bool letzterZustand;
  unsigned long wechselzeit;
};

Eingang sensor(SENSOR_PIN, ENTPRELLZEIT_MS);
Eingang resetTaste(RESET_PIN, ENTPRELLZEIT_MS);

bool postVorhanden = false;
bool resetGestartet = false;
bool resetAusgefuehrt = false;

unsigned long resetStartzeit = 0;

uint8_t pruefsummeErzeugen(uint8_t status) {
  return EEPROM_KENNUNG ^ status ^ 0xB4;
}

void ausgangAktualisieren() {
  digitalWrite(LED_PIN, postVorhanden ? HIGH : LOW);
}

void statusSpeichern() {
  Speicher neu;

  neu.kennung = EEPROM_KENNUNG;
  neu.status = postVorhanden ? 1 : 0;
  neu.pruefsumme = pruefsummeErzeugen(neu.status);

  Speicher alt;
  EEPROM.get(EEPROM_ADRESSE, alt);

  if (
    alt.kennung != neu.kennung ||
    alt.status != neu.status ||
    alt.pruefsumme != neu.pruefsumme
  ) {
    EEPROM.put(EEPROM_ADRESSE, neu);
  }
}

void statusLaden() {
  Speicher daten;
  EEPROM.get(EEPROM_ADRESSE, daten);

  bool gueltig =
    daten.kennung == EEPROM_KENNUNG &&
    daten.status <= 1 &&
    daten.pruefsumme == pruefsummeErzeugen(daten.status);

  if (gueltig) {
    postVorhanden = daten.status == 1;
  } else {
    postVorhanden = false;
    statusSpeichern();
  }
}

void postSetzen() {
  if (postVorhanden) {
    return;
  }

  postVorhanden = true;
  statusSpeichern();
  ausgangAktualisieren();
}

void postZuruecksetzen() {
  if (!postVorhanden) {
    return;
  }

  postVorhanden = false;
  statusSpeichern();
  ausgangAktualisieren();
}

void sensorBearbeiten() {
  sensor.aktualisieren();

  if (sensor.aktiviert()) {
    postSetzen();
  }
}

void resetBearbeiten() {
  resetTaste.aktualisieren();

  unsigned long jetzt = millis();

  if (resetTaste.aktiviert()) {
    resetGestartet = true;
    resetAusgefuehrt = false;
    resetStartzeit = jetzt;
  }

  if (
    resetTaste.aktiv() &&
    resetGestartet &&
    !resetAusgefuehrt &&
    jetzt - resetStartzeit >= RESETZEIT_MS
  ) {
    postZuruecksetzen();
    resetAusgefuehrt = true;
  }

  if (resetTaste.deaktiviert()) {
    resetGestartet = false;
    resetAusgefuehrt = false;
  }
}

void setup() {
  pinMode(LED_PIN, OUTPUT);

  sensor.starten();
  resetTaste.starten();

  statusLaden();
  ausgangAktualisieren();
}

void loop() {
  sensorBearbeiten();
  resetBearbeiten();
}
