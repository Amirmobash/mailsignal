#include <EEPROM.h>

constexpr uint8_t SENSOR_PIN = 2;
constexpr uint8_t RESET_PIN = 3;
constexpr uint8_t LED_PIN = 9;

constexpr unsigned long ENTPRELLZEIT_MS = 40;
constexpr unsigned long RESETZEIT_MS = 1200;

constexpr int EEPROM_ADRESSE = 0;
constexpr uint8_t STATUS_AUS = 0x3C;
constexpr uint8_t STATUS_AN = 0xC3;

class Eingang {
public:
  Eingang(uint8_t pin, unsigned long entprellzeit)
      : pin_(pin), entprellzeit_(entprellzeit) {}

  void starten() {
    pinMode(pin_, INPUT_PULLUP);

    rohzustand_ = digitalRead(pin_);
    zustand_ = rohzustand_;
    vorherigerZustand_ = zustand_;
    letzteAenderung_ = millis();
  }

  void aktualisieren() {
    vorherigerZustand_ = zustand_;

    const bool gelesen = digitalRead(pin_);
    const unsigned long jetzt = millis();

    if (gelesen != rohzustand_) {
      rohzustand_ = gelesen;
      letzteAenderung_ = jetzt;
    }

    if (zustand_ != rohzustand_ &&
        jetzt - letzteAenderung_ >= entprellzeit_) {
      zustand_ = rohzustand_;
    }
  }

  bool istAktiv() const {
    return zustand_ == LOW;
  }

  bool wurdeAktiviert() const {
    return vorherigerZustand_ == HIGH && zustand_ == LOW;
  }

  bool wurdeLosgelassen() const {
    return vorherigerZustand_ == LOW && zustand_ == HIGH;
  }

private:
  const uint8_t pin_;
  const unsigned long entprellzeit_;

  bool rohzustand_ = HIGH;
  bool zustand_ = HIGH;
  bool vorherigerZustand_ = HIGH;

  unsigned long letzteAenderung_ = 0;
};

Eingang klappensensor(SENSOR_PIN, ENTPRELLZEIT_MS);
Eingang resetTaste(RESET_PIN, ENTPRELLZEIT_MS);

bool postVorhanden = false;
bool resetLaeuft = false;

unsigned long resetStartzeit = 0;

void ledAktualisieren() {
  digitalWrite(LED_PIN, postVorhanden ? HIGH : LOW);
}

void statusSpeichern() {
  EEPROM.update(
      EEPROM_ADRESSE,
      postVorhanden ? STATUS_AN : STATUS_AUS
  );
}

void statusLaden() {
  const uint8_t gespeicherterStatus = EEPROM.read(EEPROM_ADRESSE);

  if (gespeicherterStatus == STATUS_AN) {
    postVorhanden = true;
  } else {
    postVorhanden = false;

    // Ungültigen bzw. uninitialisierten EEPROM-Inhalt korrigieren.
    if (gespeicherterStatus != STATUS_AUS) {
      statusSpeichern();
    }
  }
}

void postStatusSetzen(bool vorhanden) {
  if (postVorhanden == vorhanden) {
    return;
  }

  postVorhanden = vorhanden;
  statusSpeichern();
  ledAktualisieren();
}

void klappensensorPruefen() {
  klappensensor.aktualisieren();

  if (klappensensor.wurdeAktiviert()) {
    postStatusSetzen(true);
  }
}

void resetTastePruefen() {
  resetTaste.aktualisieren();

  const unsigned long jetzt = millis();

  if (resetTaste.wurdeAktiviert()) {
    resetStartzeit = jetzt;
    resetLaeuft = true;
  }

  if (resetLaeuft &&
      resetTaste.istAktiv() &&
      jetzt - resetStartzeit >= RESETZEIT_MS) {
    postStatusSetzen(false);
    resetLaeuft = false;
  }

  if (resetTaste.wurdeLosgelassen()) {
    resetLaeuft = false;
  }
}

void setup() {
  pinMode(LED_PIN, OUTPUT);

  klappensensor.starten();
  resetTaste.starten();

  statusLaden();
  ledAktualisieren();
}

void loop() {
  klappensensorPruefen();
  resetTastePruefen();
}
